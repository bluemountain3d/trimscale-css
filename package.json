{
  "name": "trimscale-css",
  "version": "1.0.0",
  "bin": {
    "trimscale-css": "./bin/init.js"
  },
  "description": "",
  "files": [
    "bin/*.js",
    "styles",
    "scripts/*.js",
    "models",
    "docs",
    "fixtures",
    "trimscale.config.ts"
  ],
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "generate-all": "node ./scripts/generateAll.ts",
    "generate-font-metrics": "node ./scripts/generateFontMetrics.ts",
    "generate-fluid-scale": "node ./scripts/generateFluidScale.ts",
    "generate-typography": "node ./scripts/generateTypography.ts",
    "generate-leading-trim": "node ./scripts/generateLeadingTrim.ts",
    "generate-typography-utilities": "node ./scripts/generateTypographyUtilities.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=23.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.1.2",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/html-vite": "^10.4.2",
    "@types/node": "^26.2.0",
    "storybook": "^10.4.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@types/fontkit": "^2.0.9",
    "fontkit": "^2.0.4"
  }
}
